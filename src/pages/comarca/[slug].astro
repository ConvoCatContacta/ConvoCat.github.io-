---
import ComarcaVista from '../../vistes/Comarca.astro';
import { comarques, type Comarca } from '../../lib/dades.ts';

export function getStaticPaths() {
  return comarques().map((comarca) => ({ params: { slug: comarca.llesca }, props: { comarca } }));
}

interface Props { comarca: Comarca }
const { comarca } = Astro.props;
---

<ComarcaVista comarca={comarca} idioma="ca" />
