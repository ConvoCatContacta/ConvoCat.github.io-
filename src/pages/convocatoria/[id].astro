---
import Fitxa from '../../vistes/Fitxa.astro';
import { totes, type Convocatoria } from '../../lib/dades.ts';
import { llescaId } from '../../lib/format.ts';

export function getStaticPaths() {
  return totes().map((convocatoria) => ({
    params: { id: llescaId(convocatoria.id) },
    props: { convocatoria },
  }));
}

interface Props { convocatoria: Convocatoria }
const { convocatoria } = Astro.props;
---

<Fitxa convocatoria={convocatoria} idioma="ca" />
