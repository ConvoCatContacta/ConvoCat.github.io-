---
import NoTrobat from '../../vistes/NoTrobat.astro';
import { ALTRES_IDIOMES, type Idioma } from '../../i18n/textos.ts';

export function getStaticPaths() {
  return ALTRES_IDIOMES.map((idioma) => ({ params: { idioma }, props: { idioma } }));
}

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---

<NoTrobat idioma={idioma} />
