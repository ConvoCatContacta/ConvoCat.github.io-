---
import Fitxa from '../../../vistes/Fitxa.astro';
import { totes, type Convocatoria } from '../../../lib/dades.ts';
import { llescaId } from '../../../lib/format.ts';
import { ALTRES_IDIOMES, type Idioma } from '../../../i18n/textos.ts';

export function getStaticPaths() {
  return ALTRES_IDIOMES.flatMap((idioma) =>
    totes().map((convocatoria) => ({
      params: { idioma, id: llescaId(convocatoria.id) },
      props: { convocatoria, idioma },
    }))
  );
}

interface Props { convocatoria: Convocatoria; idioma: Idioma }
const { convocatoria, idioma } = Astro.props;
---

<Fitxa convocatoria={convocatoria} idioma={idioma} />
