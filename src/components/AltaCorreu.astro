---
import { t, type Idioma } from '../i18n/textos.ts';

// La llista de correu és l'actiu del projecte, així que el lloc ha de captar des del primer
// dia. Encara no hi ha proveïdor de butlletins, i un formulari que no envia enlloc és pitjor
// que cap: mentrestant es demana l'alta per correu i es gestiona a mà.
//
// Quan hi hagi compte de Buttondown, PUBLIC_BUTTONDOWN_USER activa el formulari de debò i
// aquest text desapareix tot sol.
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const x = t(idioma).alta;

const usuari = import.meta.env.PUBLIC_BUTTONDOWN_USER;
const ADRECA = 'ConvoCatContacta@proton.me';
const enllac = `mailto:${ADRECA}?subject=${encodeURIComponent(x.assumpte)}&body=${encodeURIComponent(x.cosCorreu)}`;
---

<section class="alta">
  <h2>{x.titol}</h2>

  {
    usuari ? (
      <>
        <p>{x.cosAmbProveidor}</p>
        <form
          class="alta__form"
          action={`https://buttondown.email/api/emails/embed-subscribe/${usuari}`}
          method="post"
          target="_blank"
        >
          <label class="visually-hidden" for="correu">{x.placeholder}</label>
          <input id="correu" type="email" name="email" required placeholder={x.placeholder} />
          <button type="submit">{x.botoProveidor}</button>
        </form>
      </>
    ) : (
      <>
        <p>{x.cosManual}</p>
        <p class="alta__accio"><a class="boto" href={enllac}>{x.boto}</a></p>
        <p class="alta__lletra">{x.lletraManual}</p>
      </>
    )
  }
</section>
