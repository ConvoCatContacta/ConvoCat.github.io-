---
import { t, type Idioma } from '../i18n/textos.ts';

// La llista de correu és l'actiu del projecte, així que el formulari surt a la portada, a
// cada fitxa, a les pàgines de comarca i a la guia.
//
// L'usuari es pot sobreescriure amb PUBLIC_BUTTONDOWN_USER, però no és cap secret —apareix a
// l'acció del formulari— i tenir-hi un valor per defecte fa que funcioni igual en local i a CI
// sense haver de configurar res.
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const x = t(idioma).alta;

const usuari = import.meta.env.PUBLIC_BUTTONDOWN_USER ?? 'ConvoCat';
// Buttondown va passar de buttondown.email a buttondown.com. El domini antic encara respon
// amb una redirecció, però una redirecció en un POST pot perdre el cos: fem servir el nou.
const accio = `https://buttondown.com/api/emails/embed-subscribe/${usuari}`;
---

<section class="alta">
  <h2>{x.titol}</h2>
  <p>{x.cosAmbProveidor}</p>
  <form class="alta__form" action={accio} method="post" target="_blank">
    <label class="visually-hidden" for="correu">{x.placeholder}</label>
    <input id="correu" type="email" name="email" required placeholder={x.placeholder} />
    {/* Buttondown documenta aquest camp al seu formulari d'exemple: indica que la petició ve
        d'un formulari incrustat i condiciona la resposta que rep qui s'apunta. */}
    <input type="hidden" name="embed" value="1" />
    <button type="submit">{x.botoProveidor}</button>
  </form>
</section>
