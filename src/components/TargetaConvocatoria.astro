---
import { diesFinsA, importLlegible, llescaId, ruta, urgencia } from '../lib/format.ts';
import { t, terminiLlegible, type Idioma } from '../i18n/textos.ts';
import type { Fitxa } from '../lib/dades.ts';

interface Props { fitxa: Fitxa; avui: string; idioma: Idioma }
const { fitxa, avui, idioma } = Astro.props;
const x = t(idioma);

const dies = diesFinsA(fitxa.data_fi, avui);
const diners = importLlegible(fitxa.import_total, idioma);
---

<li
  class="targeta"
  data-comarca={fitxa.comarca ?? ''}
  data-ambit={fitxa.ambit}
  data-beneficiaris={fitxa.beneficiaris.join('|')}
  data-dies={dies ?? ''}
  data-cerca={`${fitxa.titol} ${fitxa.organ}`.toLowerCase()}
>
  <div class="targeta__dalt">
    <span class={`etiqueta etiqueta--${urgencia(dies)}`}>{terminiLlegible(dies, idioma)}</span>
    <span class="etiqueta etiqueta--ambit">{x.ambits[fitxa.ambit]}</span>
    {fitxa.comarca && <span class="etiqueta etiqueta--ambit">{fitxa.comarca}</span>}
  </div>

  <h3><a href={ruta(`/convocatoria/${llescaId(fitxa.id)}`, idioma)}>{fitxa.titol}</a></h3>

  <div class="targeta__meta">
    <span>{fitxa.organ}</span>
    {diners && <span>{x.targeta.dotacio} <strong>{diners}</strong></span>}
  </div>
</li>
