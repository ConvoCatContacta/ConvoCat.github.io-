---
import { t, type Idioma } from '../i18n/textos.ts';
// Va en el layout de cada ficha a propósito, para que no se pueda publicar una sin él.
// El resumen es orientativo: si damos por hecho que alguien cumple requisitos y no los
// cumple, el daño es real.
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const text = t(idioma).disclaimer;
const [primera, ...resta] = text.split('. ');
---

<p class="avis">
  <strong>{primera}.</strong> {resta.join('. ')}
</p>
